{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clayshot-pro-email-dev",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "PRIMARY_ADDRESS": "contact@clayshotpro.com",
    "FORWARD_TO": "",
    "ADMIN_LOGIN_ADDRESS": "admin@clayshotpro.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clayshot-pro-email-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MAIL",
      "bucket_name": "clayshot-pro-email-dev-mail"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "contact@clayshotpro.com"
      ]
    },
    {
      "name": "EMAIL_MULTI"
    }
  ],
  "triggers": {
    "crons": [
      "0 4 * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "addresses": [
    "*@clayshotpro.com"
  ]
}
